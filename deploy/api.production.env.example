NODE_ENV=production
PORT=4000

# Replace after production domain is selected.
CLIENT_URL=https://example.com

# MongoDB Atlas production connection string.
MONGODB_URI=

# Generate independent high-entropy secrets.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
INVITATION_TOKEN_SECRET=

JWT_ISSUER=cera-api
JWT_AUDIENCE=cera-web
INVITATION_TTL_HOURS=72

# Existing Cloudflare R2 private attachment storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=